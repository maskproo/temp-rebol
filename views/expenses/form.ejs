<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white border-0 pt-4">
        <h5 class="fw-bold mb-0"><%= expense && expense._id ? 'تعديل المصروف' : 'تسجيل مصروف جديد' %></h5>
      </div>
      <div class="card-body">
        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="<%= expense && expense._id ? '/expenses/' + expense._id + '?_method=PUT' : '/expenses' %>">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label required">التاريخ</label>
              <input type="date" name="date" class="form-control" value="<%= expense?.date ? new Date(expense.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label required">المبلغ (ريال)</label>
              <div class="input-group">
                <input type="number" name="amount" class="form-control" value="<%= expense?.amount || '' %>" step="0.01" min="0.01" required>
                <span class="input-group-text">ر.س</span>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label required">البيان</label>
              <input type="text" name="description" class="form-control" value="<%= expense?.description || '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label required">الفئة</label>
              <select name="category" class="form-select" required>
                <option value="">-- اختر الفئة --</option>
                <% categories.forEach(c => { %>
                <option value="<%= c %>" <%= expense?.category === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">طريقة الدفع</label>
              <select name="paymentMethod" class="form-select">
                <% ['نقداً','بنك','شيك','بطاقة'].forEach(m => { %>
                <option value="<%= m %>" <%= expense?.paymentMethod === m ? 'selected' : '' %>><%= m %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label required">الحساب المحاسبي</label>
              <select name="account" class="form-select" required>
                <option value="">-- اختر الحساب --</option>
                <% accounts.forEach(acc => { %>
                <option value="<%= acc._id %>" <%= expense?.account?.toString() === acc._id.toString() ? 'selected' : '' %>><%= acc.code %> - <%= acc.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">رقم المرجع</label>
              <input type="text" name="reference" class="form-control" value="<%= expense?.reference || '' %>" placeholder="فاتورة / إيصال">
            </div>
            <div class="col-12">
              <label class="form-label">ملاحظات</label>
              <textarea name="notes" class="form-control" rows="2"><%= expense?.notes || '' %></textarea>
            </div>
          </div>
          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>حفظ</button>
            <a href="/expenses" class="btn btn-outline-secondary">إلغاء</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
