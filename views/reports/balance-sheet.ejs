<div class="d-flex justify-content-between align-items-center mb-3 no-print">
  <form class="d-flex gap-2" method="GET">
    <div class="input-group input-group-sm">
      <span class="input-group-text">كما في</span>
      <input type="date" name="asOf" class="form-control" value="<%= asOf %>">
    </div>
    <button type="submit" class="btn btn-sm btn-primary">تطبيق</button>
  </form>
  <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer me-1"></i>طباعة</button>
</div>

<div class="row justify-content-center">
  <div class="col-md-10">
    <div class="card shadow border-0">
      <div class="card-header bg-dark text-white text-center py-3">
        <h5 class="mb-1 fw-bold">الميزانية العمومية</h5>
        <small>كما في <%= new Date(asOf).toLocaleDateString('ar-SA', {year:'numeric',month:'long',day:'numeric'}) %></small>
      </div>
      <div class="card-body p-4">
        <div class="row">
          <!-- Assets -->
          <div class="col-md-6 border-end">
            <h6 class="fw-bold text-info mb-3">الأصول</h6>
            <table class="table table-sm mb-2">
              <% assetRows.forEach(r => { %>
              <tr>
                <td class="text-muted ps-3"><small><%= r.code %></small></td>
                <td><%= r.name %></td>
                <td class="text-end"><%= r.balance.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
              </tr>
              <% }) %>
            </table>
            <div class="bg-info bg-opacity-10 p-2 rounded text-center">
              <strong class="text-info">إجمالي الأصول: <%= totalAssets.toLocaleString('ar-SA', {minimumFractionDigits:2}) %> ر.س</strong>
            </div>
          </div>

          <!-- Liabilities + Equity -->
          <div class="col-md-6">
            <h6 class="fw-bold text-warning mb-3">الالتزامات</h6>
            <table class="table table-sm mb-2">
              <% liabilityRows.forEach(r => { %>
              <tr>
                <td class="text-muted ps-3"><small><%= r.code %></small></td>
                <td><%= r.name %></td>
                <td class="text-end"><%= r.balance.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
              </tr>
              <% }) %>
            </table>
            <div class="bg-warning bg-opacity-10 p-2 rounded text-center mb-4">
              <strong class="text-warning">إجمالي الالتزامات: <%= totalLiabilities.toLocaleString('ar-SA', {minimumFractionDigits:2}) %> ر.س</strong>
            </div>

            <h6 class="fw-bold text-success mb-3">حقوق الملكية</h6>
            <table class="table table-sm mb-2">
              <% equityRows.forEach(r => { %>
              <tr>
                <td class="text-muted ps-3"><small><%= r.code %></small></td>
                <td><%= r.name %></td>
                <td class="text-end"><%= r.balance.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
              </tr>
              <% }) %>
              <tr>
                <td class="text-muted ps-3"><small>-</small></td>
                <td><%= netProfit >= 0 ? 'صافي الربح' : 'صافي الخسارة' %></td>
                <td class="text-end <%= netProfit >= 0 ? 'text-success' : 'text-danger' %>">
                  <%= netProfit.toLocaleString('ar-SA', {minimumFractionDigits:2}) %>
                </td>
              </tr>
            </table>
            <div class="bg-success bg-opacity-10 p-2 rounded text-center">
              <strong class="text-success">إجمالي حقوق الملكية: <%= totalEquity.toLocaleString('ar-SA', {minimumFractionDigits:2}) %> ر.س</strong>
            </div>
          </div>
        </div>

        <hr>
        <div class="row mt-3">
          <div class="col-6 text-center">
            <strong class="text-info fs-5">إجمالي الأصول: <%= totalAssets.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></strong>
          </div>
          <div class="col-6 text-center">
            <strong class="text-warning fs-5">الالتزامات + حقوق الملكية: <%= (totalLiabilities + totalEquity).toLocaleString('ar-SA', {minimumFractionDigits:2}) %></strong>
          </div>
        </div>

        <% const diff = Math.abs(totalAssets - (totalLiabilities + totalEquity)) %>
        <% if (diff < 0.01) { %>
        <div class="alert alert-success text-center mt-3 py-2">
          <i class="bi bi-check-circle me-2"></i>الميزانية متوازنة
        </div>
        <% } else { %>
        <div class="alert alert-warning text-center mt-3 py-2">
          <i class="bi bi-exclamation-triangle me-2"></i>فرق: <%= diff.toLocaleString('ar-SA', {minimumFractionDigits:2}) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
