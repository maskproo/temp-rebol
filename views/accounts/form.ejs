<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white border-0 pt-4">
        <h5 class="fw-bold mb-0"><%= account && account._id ? 'تعديل الحساب' : 'إضافة حساب جديد' %></h5>
      </div>
      <div class="card-body">
        <% if (error) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
        <% } %>
        <form method="POST" action="<%= account && account._id ? '/accounts/' + account._id + '?_method=PUT' : '/accounts' %>">
          <div class="mb-3">
            <label class="form-label required">كود الحساب</label>
            <input type="text" name="code" class="form-control" value="<%= account?.code || '' %>" placeholder="مثال: 1100" required>
            <small class="text-muted">رقم فريد للحساب (مثل: 1100، 4100)</small>
          </div>
          <div class="mb-3">
            <label class="form-label required">اسم الحساب</label>
            <input type="text" name="name" class="form-control" value="<%= account?.name || '' %>" placeholder="مثال: الصندوق" required>
          </div>
          <div class="mb-3">
            <label class="form-label required">نوع الحساب</label>
            <select name="type" class="form-select" required>
              <option value="">-- اختر النوع --</option>
              <% const types = [['asset','أصول'],['liability','التزامات'],['equity','حقوق الملكية'],['revenue','إيرادات'],['expense','مصاريف']] %>
              <% types.forEach(([val, label]) => { %>
              <option value="<%= val %>" <%= account?.type === val ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">الوصف</label>
            <textarea name="description" class="form-control" rows="2"><%= account?.description || '' %></textarea>
          </div>
          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="isActive" value="true"
                <%= !account || account.isActive ? 'checked' : '' %>>
              <label class="form-check-label">حساب نشط</label>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>حفظ</button>
            <a href="/accounts" class="btn btn-outline-secondary">إلغاء</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
