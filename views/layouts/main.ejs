<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | نظام المحاسبة</title>
  <link rel="stylesheet" href="/node_modules/bootstrap/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- Sidebar -->
<div class="d-flex" id="wrapper">
  <div id="sidebar" class="bg-dark text-white p-3">
    <div class="text-center mb-4 py-2 border-bottom border-secondary">
      <i class="bi bi-journal-bookmark-fill fs-2 text-primary"></i>
      <h6 class="mt-2 mb-0 fw-bold">نظام المحاسبة</h6>
      <small class="text-muted">الإصدار 1.0</small>
    </div>
    <nav class="nav flex-column gap-1">
      <a href="/" class="nav-link text-white rounded <%= title === 'لوحة التحكم' ? 'active bg-primary' : 'hover-link' %>">
        <i class="bi bi-speedometer2 me-2"></i> لوحة التحكم
      </a>
      <div class="nav-section mt-3 mb-1">
        <small class="text-muted text-uppercase px-2">المحاسبة</small>
      </div>
      <a href="/accounts" class="nav-link text-white rounded <%= title && title.includes('الحساب') ? 'active bg-primary' : 'hover-link' %>">
        <i class="bi bi-list-ul me-2"></i> دليل الحسابات
      </a>
      <a href="/journal" class="nav-link text-white rounded <%= title && title.includes('القيود') || title && title.includes('القيد') ? 'active bg-primary' : 'hover-link' %>">
        <i class="bi bi-journal-text me-2"></i> القيود اليومية
      </a>
      <div class="nav-section mt-3 mb-1">
        <small class="text-muted text-uppercase px-2">المبيعات</small>
      </div>
      <a href="/customers" class="nav-link text-white rounded <%= title && (title.includes('العملاء') || title === title) && typeof customer !== 'undefined' ? 'active bg-primary' : 'hover-link' %>">
        <i class="bi bi-people me-2"></i> العملاء
      </a>
      <a href="/invoices" class="nav-link text-white rounded <%= title && title.includes('الفواتير') || title && title.includes('فاتورة') ? 'active bg-primary' : 'hover-link' %>">
        <i class="bi bi-receipt me-2"></i> الفواتير
      </a>
      <div class="nav-section mt-3 mb-1">
        <small class="text-muted text-uppercase px-2">المصاريف</small>
      </div>
      <a href="/expenses" class="nav-link text-white rounded <%= title && title.includes('المصاريف') || title && title.includes('مصروف') ? 'active bg-primary' : 'hover-link' %>">
        <i class="bi bi-cash-stack me-2"></i> المصاريف
      </a>
      <div class="nav-section mt-3 mb-1">
        <small class="text-muted text-uppercase px-2">التقارير</small>
      </div>
      <a href="/reports/income" class="nav-link text-white rounded hover-link">
        <i class="bi bi-graph-up me-2"></i> قائمة الدخل
      </a>
      <a href="/reports/balance" class="nav-link text-white rounded hover-link">
        <i class="bi bi-bank me-2"></i> الميزانية العمومية
      </a>
      <a href="/reports/trial" class="nav-link text-white rounded hover-link">
        <i class="bi bi-table me-2"></i> ميزان المراجعة
      </a>
    </nav>
  </div>

  <!-- Main Content -->
  <div id="page-content" class="flex-grow-1">
    <!-- Topbar -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm px-4">
      <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle">
        <i class="bi bi-list fs-5"></i>
      </button>
      <span class="navbar-brand mb-0 h6 fw-bold text-dark"><%= title %></span>
      <div class="ms-auto d-flex align-items-center gap-2">
        <span class="text-muted small">
          <i class="bi bi-calendar3 me-1"></i>
          <%= new Date().toLocaleDateString('ar-SA', {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'}) %>
        </span>
      </div>
    </nav>

    <!-- Content -->
    <main class="p-4">
      <%- body %>
    </main>
  </div>
</div>

<script src="/node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="/node_modules/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
