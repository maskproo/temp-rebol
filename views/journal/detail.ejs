<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4">
        <div>
          <h5 class="fw-bold mb-1">تفاصيل القيد</h5>
          <small class="text-muted"><%= new Date(entry.date).toLocaleDateString('ar-SA', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %></small>
        </div>
        <div class="d-flex gap-2 no-print">
          <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer me-1"></i>طباعة</button>
          <a href="/journal" class="btn btn-sm btn-outline-secondary">رجوع</a>
        </div>
      </div>
      <div class="card-body">
        <div class="row mb-4">
          <div class="col-6">
            <small class="text-muted d-block">البيان</small>
            <span class="fw-medium"><%= entry.description %></span>
          </div>
          <div class="col-3">
            <small class="text-muted d-block">المرجع</small>
            <span><%= entry.reference || '-' %></span>
          </div>
          <div class="col-3">
            <small class="text-muted d-block">المصدر</small>
            <% const srcMap = {manual:'يدوي',invoice:'فاتورة',expense:'مصروف',payment:'دفعة'} %>
            <span><%= srcMap[entry.source] || entry.source %></span>
          </div>
        </div>

        <table class="table table-bordered">
          <thead class="table-light">
            <tr>
              <th>الحساب</th>
              <th>البيان</th>
              <th class="text-end">مدين</th>
              <th class="text-end">دائن</th>
            </tr>
          </thead>
          <tbody>
            <% entry.lines.forEach(line => { %>
            <tr>
              <td><%= line.account?.code %> - <%= line.account?.name %></td>
              <td><small class="text-muted"><%= line.description || '-' %></small></td>
              <td class="text-end"><%= line.debit > 0 ? line.debit.toLocaleString('ar-SA', {minimumFractionDigits:2}) : '' %></td>
              <td class="text-end"><%= line.credit > 0 ? line.credit.toLocaleString('ar-SA', {minimumFractionDigits:2}) : '' %></td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot class="table-light fw-bold">
            <tr>
              <td colspan="2" class="text-end">المجموع</td>
              <% const td = entry.lines.reduce((s,l)=>s+l.debit,0) %>
              <% const tc = entry.lines.reduce((s,l)=>s+l.credit,0) %>
              <td class="text-end"><%= td.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
              <td class="text-end"><%= tc.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
            </tr>
          </tfoot>
        </table>
        <% if (Math.abs(entry.lines.reduce((s,l)=>s+l.debit,0) - entry.lines.reduce((s,l)=>s+l.credit,0)) < 0.01) { %>
        <div class="alert alert-success py-2"><i class="bi bi-check-circle me-2"></i>القيد متوازن</div>
        <% } else { %>
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-2"></i>القيد غير متوازن!</div>
        <% } %>
      </div>
    </div>
  </div>
</div>
