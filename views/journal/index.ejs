<div class="d-flex justify-content-between align-items-center mb-3">
  <form class="d-flex gap-2 flex-wrap" method="GET">
    <input type="date" name="from" class="form-control form-control-sm" value="<%= query.from || '' %>" style="width:150px">
    <input type="date" name="to" class="form-control form-control-sm" value="<%= query.to || '' %>" style="width:150px">
    <input type="text" name="search" class="form-control form-control-sm" placeholder="بحث..." value="<%= query.search || '' %>" style="width:160px">
    <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
    <a href="/journal" class="btn btn-sm btn-outline-secondary">مسح</a>
  </form>
  <a href="/journal/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> قيد جديد</a>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>التاريخ</th>
          <th>المرجع</th>
          <th>البيان</th>
          <th>المصدر</th>
          <th class="text-end">مجموع مدين</th>
          <th class="text-end">مجموع دائن</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% entries.forEach(entry => { %>
        <% const totalD = entry.lines.reduce((s,l) => s + l.debit, 0) %>
        <% const totalC = entry.lines.reduce((s,l) => s + l.credit, 0) %>
        <tr>
          <td><%= new Date(entry.date).toLocaleDateString('ar-SA') %></td>
          <td><small class="text-muted"><%= entry.reference || '-' %></small></td>
          <td><a href="/journal/<%= entry._id %>" class="text-decoration-none fw-medium"><%= entry.description %></a></td>
          <td>
            <% const srcMap = {manual:'يدوي',invoice:'فاتورة',expense:'مصروف',payment:'دفعة'} %>
            <% const srcColor = {manual:'secondary',invoice:'primary',expense:'danger',payment:'success'} %>
            <span class="badge bg-<%= srcColor[entry.source] || 'secondary' %>"><%= srcMap[entry.source] || entry.source %></span>
          </td>
          <td class="text-end"><%= totalD.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
          <td class="text-end"><%= totalC.toLocaleString('ar-SA', {minimumFractionDigits:2}) %></td>
          <td>
            <% if (entry.source === 'manual') { %>
            <form action="/journal/<%= entry._id %>?_method=DELETE" method="POST" class="d-inline">
              <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="حذف هذا القيد؟">
                <i class="bi bi-trash"></i>
              </button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (entries.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">لا توجد قيود</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
